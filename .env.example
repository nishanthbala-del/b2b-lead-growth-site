# Copy this file to .env.local and fill in the values.
# In production (Vercel), set these in Project Settings → Environment Variables.

# Public scheduler link shown after a successful intake submission.
# Works with Calendly, Cal.com, or a Google Calendar appointment schedule.
# This is also the built-in default in components/IntakeForm.tsx; override it
# here / in Vercel only if the canonical booking link changes.
NEXT_PUBLIC_BOOKING_URL=https://calendar.app.google/1gmKxyRv4gntbuU6A

# Google Sheets storage: the Apps Script web app URL (see SETUP.md, step 1).
# When set, every submission is appended to your Google Sheet.
SHEETS_WEBHOOK_URL=

# Optional: a shared secret your Apps Script checks before accepting writes.
SHEETS_WEBHOOK_SECRET=

# Canonical site URL (used for SEO / social card links). Use the STABLE Vercel
# production URL (no custom domain). This is also the built-in default in lib/site.ts;
# only override it here / in Vercel if you later add a real custom domain.
NEXT_PUBLIC_SITE_URL=https://b2b-lead-growth-site.vercel.app
